{"pageProps":{"rule":{"metadata":{"updated_date":"2020-10-19T00:00:00.000Z","creation_date":"2020-10-19T00:00:00.000Z","source_siem":"Sigma","source_siem_id":"sigma","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_system_network_connections_discovery.yml"},"rule":{"name":"System Network Connections Discovery - Linux","description":"Detects attempts to discover system network connections via common Linux utilities.\nAdversaries may use tools such as netstat, ss, or lsof to enumerate active connections,\nopen ports, and listening services on a compromised system.\n","tags":["Rule Type: Sigma","Data Source: Cross-SIEM","Tactic: Discovery","Technique: T1049","OS: Linux","Domain: process creation","SIEM: Sigma"],"severity":"low","risk_score":21,"type":"sigma","language":"sigma","query":"{\n  \"selection\": {\n    \"Image|endswith\": [\n      \"/lsof\",\n      \"/netstat\",\n      \"/sockstat\",\n      \"/ss\"\n    ]\n  },\n  \"condition\": \"selection\"\n}","reference":["https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1049/T1049.md","https://man7.org/linux/man-pages/man8/netstat.8.html","https://man7.org/linux/man-pages/man8/ss.8.html","https://man7.org/linux/man-pages/man8/lsof.8.html"],"false_positives":["Legitimate administration activities"]}}},"__N_SSG":true}