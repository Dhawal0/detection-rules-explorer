{"pageProps":{"rule":{"metadata":{"updated_date":"2020-10-11T00:00:00.000Z","creation_date":"2020-10-11T00:00:00.000Z","source_siem":"Sigma","source_siem_id":"sigma","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_local_groups.yml"},"rule":{"name":"Local Groups Discovery Attempt - Linux","description":"Detects attempts to enumerate local groups and group membership via common Linux utilities and sensitive file access.\nAdversaries may read files such as /etc/group and /etc/gshadow, or use tools like getent and groups to identify\ngroup memberships and privilege assignments on a compromised system.\n","tags":["Rule Type: Sigma","Data Source: Cross-SIEM","Tactic: Discovery","Technique: T1069.001","OS: Linux","Domain: process creation","SIEM: Sigma"],"severity":"low","risk_score":21,"type":"sigma","language":"sigma","query":"{\n  \"selection_groups\": {\n    \"Image|endswith\": \"/groups\"\n  },\n  \"selection_read_utilities\": {\n    \"Image|endswith\": [\n      \"/cat\",\n      \"/ed\",\n      \"/emacs\",\n      \"/head\",\n      \"/less\",\n      \"/makemap\",\n      \"/more\",\n      \"/nano\",\n      \"/sqlite3\",\n      \"/tail\",\n      \"/vi\",\n      \"/vim\"\n    ],\n    \"CommandLine|contains\": [\n      \"group\",\n      \"gshadow\"\n    ]\n  },\n  \"selection_getent\": {\n    \"Image|endswith\": \"/getent\",\n    \"CommandLine|contains\": [\n      \" group\",\n      \" gshadow\"\n    ]\n  },\n  \"selection_ypcat\": {\n    \"Image|endswith\": \"/ypcat\",\n    \"CommandLine|contains\": \"group\"\n  },\n  \"condition\": \"1 of selection_*\"\n}","reference":["https://github.com/redcanaryco/atomic-red-team/blob/f339e7da7d05f6057fdfcdd3742bfcf365fee2a9/atomics/T1069.001/T1069.001.md","https://man7.org/linux/man-pages/man1/getent.1.html"],"false_positives":["Legitimate administration activities"]}}},"__N_SSG":true}