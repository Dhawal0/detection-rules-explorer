{"pageProps":{"rule":{"metadata":{"updated_date":"2026-10-17T00:00:00.000Z","creation_date":"2026-10-17T00:00:00.000Z","source_siem":"Sigma","source_siem_id":"sigma","source_url":"https://github.com/SigmaHQ/sigma/blob/master/rules/linux/process_creation/proc_creation_lnx_celery_worker_shell_spawn.yml"},"rule":{"name":"Shell Spawned by Celery Worker Process","description":"Detects a system shell interpreter being spawned directly by a Celery worker process.\nThis behavior indicates a Python background task execution framework is evaluating raw string input through a shell execution context,\nwhich is highly indicative of successful command or prompt injection exploitation against an LLM agent task.\n","tags":["Rule Type: Sigma","Data Source: Cross-SIEM","Tactic: Execution","Technique: T1059.004","OS: Linux","Domain: process creation","SIEM: Sigma"],"severity":"medium","risk_score":47,"type":"sigma","language":"sigma","query":"{\n  \"selection_img\": {\n    \"Image|endswith\": [\n      \"/ash\",\n      \"/bash\",\n      \"/busybox\",\n      \"/csh\",\n      \"/dash\",\n      \"/fish\",\n      \"/ksh\",\n      \"/sh\",\n      \"/tcsh\",\n      \"/zsh\"\n    ],\n    \"ParentCommandLine|contains\": \"celery\"\n  },\n  \"selection_parent\": [\n    {\n      \"ParentImage|endswith\": [\n        \"/python\",\n        \"/python3\"\n      ]\n    },\n    {\n      \"ParentImage|contains\": \"/python3.\"\n    }\n  ],\n  \"condition\": \"all of selection_*\"\n}","reference":["https://docs.celeryq.dev/en/stable/userguide/tasks.html","https://genai.owasp.org/llmrisk/llm01-prompt-injection/","https://labs.cloudsecurityalliance.org/research/csa-research-note-promptware-c2-agent-exploitation-20260406/","https://nvd.nist.gov/vuln/detail/CVE-2021-23727","https://owasp.org/www-project-top-10-for-large-language-model-applications/","https://security.snyk.io/vuln/SNYK-PYTHON-CELERY-2314953","https://snyk.io/blog/python-rce-vulnerability/","https://unit42.paloaltonetworks.com/ai-agent-prompt-injection/","https://www.microsoft.com/en-us/security/blog/2026/05/07/prompts-become-shells-rce-vulnerabilities-ai-agent-frameworks"],"false_positives":["Legacy or custom administrative tasks deliberately hardcoded with shell=True or os.system execution inside Celery task functions.","Media processing, deployment, or reporting pipelines that intentionally shell out to external tools (e.g. ffmpeg, git) from within a task."]}}},"__N_SSG":true}